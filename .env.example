# Copy to .env and fill in values.
# All variables are prefixed with CRAWLER_.

# --- LLM ---
CRAWLER_OPENAI_API_KEY=sk-...
CRAWLER_OPENAI_MODEL=gpt-4o-mini

# --- Redis ---
CRAWLER_REDIS_URL=redis://localhost:6379/0
CRAWLER_REDIS_POOL_SIZE=20

# --- Crawl behaviour ---
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_PAGES=100000
CRAWLER_CONCURRENCY=50
CRAWLER_THREAD_POOL_SIZE=8
CRAWLER_REQUEST_TIMEOUT_SECONDS=30.0
CRAWLER_MAX_RETRIES=3

# --- Rate limiting ---
CRAWLER_DEFAULT_RATE_LIMIT_RPS=2.0
CRAWLER_MIN_RATE_LIMIT_RPS=0.5
CRAWLER_MAX_RATE_LIMIT_RPS=10.0

# --- Output ---
CRAWLER_OUTPUT_DIR=./output
CRAWLER_LOG_LEVEL=INFO
